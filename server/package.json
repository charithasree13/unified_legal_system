{
  "name": "unified-legal-system-server",
  "version": "1.0.0",
  "description": "Backend API Server for Unified Legal System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsnd --respawn --transpile-only src/index.ts",
    "migrate": "tsnd --transpile-only src/scripts/migrate.ts",
    "reminders:check": "ts-node --transpile-only src/scripts/runReminders.ts",
    "reminders:test": "ts-node --transpile-only src/scripts/runReminders.ts --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
